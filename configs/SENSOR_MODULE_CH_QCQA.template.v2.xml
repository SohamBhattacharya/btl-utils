<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ROOT xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <HEADER>
    <TYPE>
      <EXTENSION_TABLE_NAME>SENSOR_MODULE_CH_QCQA</EXTENSION_TABLE_NAME>
      <NAME>SENSOR MODULE CH QCQA</NAME>
    </TYPE>
    <RUN>
      <RUN_NAME>{run}</RUN_NAME>
      <RUN_TYPE>{run_type}</RUN_TYPE>
      <RUN_BEGIN_TIMESTAMP>template_run_begin</RUN_BEGIN_TIMESTAMP>
      <RUN_END_TIMESTAMP>template_run_end</RUN_END_TIMESTAMP>
    </RUN>
  </HEADER>
  <DATA_SET>
    <VERSION>1</VERSION>
    <PART>
      <KIND_OF_PART>SensorModule</KIND_OF_PART>
      <BARCODE>{barcode}</BARCODE>
    </PART>
    <CATEGORY>{category}</CATEGORY>
    <UNITS>
      <SPE>pC</SPE>
      <LO>p.e./MeV</LO>
      <SRC>pC/KeV</SRC>
      <ERES>percentage</ERES>
    </UNITS>
    <DATA>
      <CHANNEL>{channel}</CHANNEL>
      
      <CH_SPE_LEFT>format({a_spe_L_corr}[{channel}], "0.4f")</CH_SPE_LEFT>
      <CH_SPE_RIGHT>format({a_spe_R_corr}[{channel}], "0.4f")</CH_SPE_RIGHT>
      <BAR_SPE>format({a_spe_bar_corr}[{channel}], "0.4f")</BAR_SPE>
      
      <CH_SRC_LEFT>format({a_src_L_corr}[{channel}], "0.4f")</CH_SRC_LEFT>
      <CH_SRC_RIGHT>format({a_src_R_corr}[{channel}], "0.4f")</CH_SRC_RIGHT>
      <BAR_SRC>format({a_src_bar_corr}[{channel}], "0.4f")</BAR_SRC>
      
      <CH_LO_LEFT>format({a_lo_L_corr}[{channel}], "0.4f")</CH_LO_LEFT>
      <CH_LO_RIGHT>format({a_lo_R_corr}[{channel}], "0.4f")</CH_LO_RIGHT>
      <BAR_LO>format({a_lo_bar_corr}[{channel}], "0.4f")</BAR_LO>
      
      <CH_ERES_LEFT>format({a_enres_L_corr}[{channel}], "0.4f")</CH_ERES_LEFT>
      <CH_ERES_RIGHT>format({a_enres_R_corr}[{channel}], "0.4f")</CH_ERES_RIGHT>
      <BAR_ERES>format({a_enres_bar_corr}[{channel}], "0.4f")</BAR_ERES>
      
      <TEMP>template_TEMP</TEMP>
    </DATA>
  </DATA_SET>
</ROOT>
